# ============================================================
# Host (Vite) — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# No Vite, só variáveis com prefixo VITE_ ficam visíveis no app.
# ============================================================

# RAIZ das Azure Functions (backend MongoDB). SEM "/api" e SEM barra no final.
# O código monta as rotas sozinho (ex.: ${VITE_FUNCTIONS_URL}/api/seed).

# --- Local (com `func start` na pasta functions/) ---
VITE_FUNCTIONS_URL=http://localhost:7071

# --- Produção (exemplo — troque pelo host do SEU Function App) ---
# VITE_FUNCTIONS_URL=https://furafila-xxxx.brazilsouth-01.azurewebsites.net
